		tempertureSensorTypeTrap  OBJECT-TYPE      
                       SYNTAX  DisplayString (SIZE (0..255))
                       MAX-ACCESS  read-only
                       STATUS  current
                       DESCRIPTION
                       "Sensor type"
                       ::= { chkpntTrapInfo 39 } 
                        
		tempertureSensorStatusTrap  OBJECT-TYPE      
                       SYNTAX  Integer32(1..65535)
                       MAX-ACCESS  read-only
                       STATUS  current
                       DESCRIPTION
                       "Sensor is out of range TRUE(1), FALSE(0), READING ERROR(2)"
