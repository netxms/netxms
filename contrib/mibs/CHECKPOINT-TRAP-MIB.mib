                       SYNTAX  DisplayString (SIZE (0..255))
                       MAX-ACCESS  read-only
                       STATUS  current
                       DESCRIPTION
                       "Sensor type"
                       ::= { chkpntTrapInfo 44 }  
                        
		fanSpeedSensorStatusTrap  OBJECT-TYPE      
                       SYNTAX  Integer32(1..65535)
