#
# Sample configuration file for NetXMS server
#

#
# DBDriver
#
# Database driver to use
#
# DBDriver = mariadb.ddr
# DBDriver = mssql.ddr
# DBDriver = mysql.ddr
# DBDriver = oracle.ddr
# DBDriver = pgsql.ddr
# DBDriver = sqlite.ddr

#
# DBServer
#
# Database server (ODBC source name for ODBC driver)
#
# Example:
# DBServer = localhost

#
# DBName
#
# Database name (not used by ODBC driver)
#
# Example:
# DBName = netxms_db

#
# DBLogin
#
# Database user name
#
# Example:
# DBLogin = netxms

#
# DBPassword
#
# Database user's password
#
# Example:
# DBPassword = password

#
# CurlSSLBackend
#
# TLS backend used by libcurl for HTTPS requests (notification channels,
# web hooks, NXSL HTTP client, helpdesk integrations). Only meaningful for
# Windows builds where libcurl is built with multiple backends; otherwise
# the value is ignored with a warning in the log. With "schannel" (default
# on Windows) certificate trust comes from the Windows certificate store.
#
# Possible values: schannel, openssl
#
# Example:
# CurlSSLBackend = openssl

#
# LogFailedSQLQueries
#
# Controls logging of failed SQL queries.
# Possible values: "yes" (default) or "no".
#
# Example:
# LogFailedSQLQueries = yes

#
# LogFile
#
# Server's log file. To write log to syslog (or Event Log on Windows),
# use {syslog} as file name.
#
# Examples:
# LogFile = {syslog}
# LogFile = /var/log/netxms
