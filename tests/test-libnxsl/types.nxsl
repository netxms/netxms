/* Check data types */

i32 = 17;
i64 = 5000000000;
r = 0.25;
s = "string";
n = null;
o = new DateTime();
a = %(1, 2, 3);
m = %{ "one":1, "two":2 };

assert(typeof(i32) == "int32");
assert(typeof(i64) == "int64");
assert(typeof(r) == "real");
assert(typeof(s) == "string");
assert(typeof(n) == "null");
assert(typeof(o) == "object");
assert(classof(o) == "DateTime");
assert(typeof(a) == "array");
assert(typeof(m) == "hashmap");

assert(typeof(i32 .. s) == "string");
assert(typeof(string(n)) == "string");
assert(typeof(int64(i32)) == "int64");
assert(typeof(r * i32) == "real");
assert(typeof(i32 / 2) == "real");
assert(typeof(i32 \ 2) == "int64");
assert(typeof(i64 / 2) == "real");
assert(typeof(i64 \ 2) == "int64");
assert(typeof(r \ 2) == "int64");

// Integer operations are performed as signed 64 bit numbers;
// uint64 operand keeps entire operation in unsigned 64 bit domain
assert(typeof(i32 + 1) == "int64");
assert(typeof(i32 * i32) == "int64");
assert(typeof(-i32) == "int64");
assert(typeof(~i32) == "int64");

u32 = uint32(3000000000);
assert(typeof(u32) == "uint32");
assert(typeof(u32 + 1) == "int64");
assert(typeof(u32 - u32) == "int64");

u64 = 1UL;
assert(typeof(u64) == "uint64");
assert(typeof(u64 + 1) == "uint64");
assert(typeof(u64 * u32) == "uint64");
assert(typeof(int64(u64) + 1) == "int64");

i32++;
assert(typeof(i32) == "int64");

return 0;
