/* Compound assignment operators on all lvalue kinds: variables, array/hash map elements, and storage items */

// Variables
x = 17; x += 3;  assert(x == 20);
x = 17; x -= 3;  assert(x == 14);
x = 17; x *= 3;  assert(x == 51);
x = 20; x /= 4;  assert(x == 5);
x = 17; x \= 5;  assert(x == 3);
x = 17; x %= 5;  assert(x == 2);
x = "ab"; x ..= "cd"; assert(x == "abcd");
x = 12; x &= 10; assert(x == 8);
x = 12; x |= 10; assert(x == 14);
x = 12; x ^= 10; assert(x == 6);

// Array elements
a = [17, 17, 17, 20, 17, 17, "ab", 12, 12, 12];
a[0] += 3;  assert(a[0] == 20);
a[1] -= 3;  assert(a[1] == 14);
a[2] *= 3;  assert(a[2] == 51);
a[3] /= 4;  assert(a[3] == 5);
a[4] \= 5;  assert(a[4] == 3);
a[5] %= 5;  assert(a[5] == 2);
a[6] ..= "cd"; assert(a[6] == "abcd");
a[7] &= 10; assert(a[7] == 8);
a[8] |= 10; assert(a[8] == 14);
a[9] ^= 10; assert(a[9] == 6);

// Hash map elements
m = { "idiv": 17, "rem": 17 };
m["idiv"] \= 5; assert(m["idiv"] == 3);
m["rem"] %= 5;  assert(m["rem"] == 2);

// Storage items
#s = 17; #s += 3;  assert(#s == 20);
#s = 17; #s -= 3;  assert(#s == 14);
#s = 17; #s *= 3;  assert(#s == 51);
#s = 20; #s /= 4;  assert(#s == 5);
#s = 17; #s \= 5;  assert(#s == 3);
#s = 17; #s %= 5;  assert(#s == 2);
#s = "ab"; #s ..= "cd"; assert(#s == "abcd");
#s = 12; #s &= 10; assert(#s == 8);
#s = 12; #s |= 10; assert(#s == 14);
#s = 12; #s ^= 10; assert(#s == 6);

return 0;
