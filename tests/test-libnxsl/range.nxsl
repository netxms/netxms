r = range(10);
assert(classof(r) == "Range");
assert(r.start == 0);
assert(r.end == 10);
assert(r.step == 1);

r = new Range(1, 2, 0.5);
assert(r.start == 1);
assert(r.end == 2);
assert(r.step == 0.5);

count = 0;
sum = 0;
for(i : range(10))
{
   count++;
   sum += i;
}
assert(count == 10);
assert(sum == 45);

count = 0;
for(n : range(1, 0, -0.1))
   count++;
assert(count == 10);

function RangeToString(r)
{
   s = "";
   for(v : r)
      s ..= v .. ",";
   return s;
}

assert(RangeToString(range(0)) == "");
assert(RangeToString(range(5, 5)) == "");
assert(RangeToString(range(3, 1)) == "");
assert(RangeToString(range(1, 3, -1)) == "");
assert(RangeToString(range(1, 10, 0)) == "");
assert(RangeToString(range(1.0, 10.0, 0.0)) == "");
assert(RangeToString(range(-10, -5)) == "-10,-9,-8,-7,-6,");
assert(RangeToString(range(-3, 0)) == "-3,-2,-1,");
assert(RangeToString(range(-3)) == "");
assert(RangeToString(range(10, 2, -2)) == "10,8,6,4,");
assert(RangeToString(range(-2, -10, -3)) == "-2,-5,-8,");
assert(RangeToString(range(-2.0, -4.0, -0.5)) == "-2.0,-2.5,-3.0,-3.5,");
assert(RangeToString(range(-1.0, 0.0, 0.5)) == "-1.0,-0.5,");
assert(RangeToString(range(2.0, 2.0)) == "");

assert(Count(range(0)) == 0);
assert(Count(range(5, 5)) == 0);
assert(Count(range(3, 1)) == 0);
assert(Count(range(-10, -5)) == 5);
assert(Sum(range(-10, -5)) == -40);
assert(Count(range(-3, 0)) == 3);
assert(Sum(range(-3, 0)) == -6);
assert(Count(range(5, 0, -1)) == 5);
assert(Sum(range(5, 0, -1)) == 15);
assert(Count(range(0, 5, 0)) == 0);
assert(Count(range(5, 0, 0)) == 0);
assert(Count(range(-1.0, 0.0, 0.25)) == 4);
assert(Count(range(2.0, 2.0)) == 0);
assert(Count(range(0.0, 5.0, 0.0)) == 0);
assert(Count(range(5.0, 0.0, 0.0)) == 0);

// Next value overflowing int64 terminates iteration instead of wrapping around
assert(RangeToString(range(9223372036854775806, 9223372036854775807, 2)) == "9223372036854775806,");
assert(RangeToString(range(9223372036854775805, 9223372036854775807, 2)) == "9223372036854775805,");
assert(RangeToString(range(1, 9223372036854775807, 9223372036854775807)) == "1,");
assert(RangeToString(range(-9223372036854775807, -9223372036854775807 - 1, -2)) == "-9223372036854775807,");
assert(RangeToString(range(-1, -9223372036854775807 - 1, -9223372036854775807)) == "-1,");

return 0;

function Count(r)
{
   c = 0;
   for(i : r)
      c++;
   return c;
}

function Sum(r)
{
   s = 0;
   for(i : r)
      s += i;
   return s;
}
