#
# Makefile.w32 - test-nxshell (NetXMS shell input parsing tests) for Windows/MinGW
# Part of NetXMS project
#

# parser.cpp is compiled into the test binary. It is located through vpath so
# its object lands in this test's own object directory instead of the tool's.
vpath %.cpp $(TOPDIR)/src/client/nxshell

TOOL = test-nxshell
SOURCES = test-nxshell.cpp parser.cpp
TOOL_CPPFLAGS = -I$(TOPDIR)/tests/include -I$(TOPDIR)/src/client/nxshell
TOOL_LIBS = -lnetxms

include $(TOPDIR)/build/tool-common.mk
