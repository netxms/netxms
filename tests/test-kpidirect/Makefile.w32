#
# Makefile.w32 - test-kpidirect (direct KPI computation provider tests) for Windows/MinGW
# Part of NetXMS project
#

# integrate.cpp and compose.cpp are compiled into the test binary rather than
# linked from the built module. They are located through vpath so their objects
# land in this test's own object directory instead of the module's.
vpath %.cpp $(TOPDIR)/src/server/kpidirect

TOOL = test-kpidirect
SOURCES = test-kpidirect.cpp integrate.cpp compose.cpp
TOOL_CPPFLAGS = -I$(TOPDIR)/tests/include -I$(TOPDIR)/src/server/kpidirect
TOOL_LIBS = -lnetxms

include $(TOPDIR)/build/tool-common.mk
